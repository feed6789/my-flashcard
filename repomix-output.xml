                    ref.read(ttsProvider.notifier).state = newSettings;

                    // Test TTS với ngôn ngữ đã chọn
                    if (tempEnabled && _currentCards.isNotEmpty) {
                      _speakCard(_currentCards[_currentIndex], tempLanguage);
