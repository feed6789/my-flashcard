              {'key': 'enLevel', 'label': '📊 CEFR Level'},
              {'key': 'hanViet', 'label': '🇻🇳 Han-Viet'},
              {'key': 'cnCharacter', 'label': '🇨🇳 Chinese Character'},
              {'key': 'cnPinyin', 'label': '🔊 Chinese Pinyin'},
              {'key': 'cnLevel', 'label': '📊 HSK Level'},
              {'key': 'exampleSentence', 'label': '💬 Example Sentence'},
