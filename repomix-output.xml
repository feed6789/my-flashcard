                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      const Text('Enable TTS'),
                      Switch(
                        value: tempEnabled,
                        onChanged: (value) {
                          setState(() {
                            tempEnabled = value;
                          });
                        },
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),

                  // Auto-play
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      const Text('Auto-play on flip'),
                      Switch(
                        value: tempAutoPlay,
                        onChanged: tempEnabled
                            ? (value) {
                                setState(() {
                                  tempAutoPlay = value;
                                });
                              }
                            : null,
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),

