  Color _getStatusColor(String status) {
    switch (status) {
      case 'new':
        return Colors.grey;
      case 'learning':
        return Colors.orange;
      case 'reviewing':
        return Colors.blue;
      case 'mastered':
        return Colors.green;
      default:
        return Colors.grey;
    }
  }

