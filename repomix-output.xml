                      _saveFontSizesToPrefs(defaultSizes);
                      _saveTextAlignmentToPrefs(TextAlign.center);
                      _saveAllStudySettings();
                    }
                  },
                  child: const Text('Reset to Defaults'),
                ),
              ),
            ],
          ),
        );
      },
    );
