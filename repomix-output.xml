                  if (page == -1) {
                    return const Padding(
                      padding: EdgeInsets.symmetric(horizontal: 4),
                      child: Text('...'),
                    );
                  }
                  return Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 2),
                    child: ChoiceChip(
                      label: Text('${page + 1}'),
                      selected: _currentPage == page,
                      onSelected: (selected) {
                        if (selected) {
                          setState(() {
                            _currentPage = page;
                          });
                          _loadFlashcardsWithFilter(); // Load lại trang mới
                        }
                      },
                    ),
                  );
                }),
                IconButton(
                  icon: const Icon(Icons.chevron_right),
                  onPressed: (_currentPage + 1) * _pageSize < _totalItems
                      ? () {
                          setState(() {
                            _currentPage++;
                          });
                          _loadFlashcardsWithFilter(); // Load lại trang mới
                        }
                      : null,
                ),
              ],
            ),
          ),
        if (_isLoadingMore)
          const Padding(
            padding: EdgeInsets.all(8.0),
            child: Center(
              child: CircularProgressIndicator(),
            ),
          ),
      ],
    );
  }

  List<int> _getPageNumbers() {
    final totalPages = (_totalItems / _pageSize).ceil();
    if (totalPages <= 7) {
      return List.generate(totalPages, (i) => i);
    }

    List<int> pages = [];
    if (_currentPage < 3) {
      pages = [0, 1, 2, 3, 4, -1, totalPages - 1];
    } else if (_currentPage > totalPages - 4) {
      pages = [
        0,
        -1,
        totalPages - 5,
        totalPages - 4,
        totalPages - 3,
        totalPages - 2,
        totalPages - 1
      ];
    } else {
      pages = [
        0,
        -1,
        _currentPage - 1,
        _currentPage,
        _currentPage + 1,
        -1,
        totalPages - 1
      ];
    }
    return pages;
  }

